{
    "name": "fogon/club-deportivo",
    "description": "Sistema de gestión para Club Deportivo y Social El Fogón",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Core\\": "app/core/",
            "App\\Controllers\\": "controllers/",
            "App\\Models\\": "models/",
            "App\\Libs\\": "libs/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}

<script type="text/javascript">
  const el = (sel) => document.querySelector(sel);
  const tienePermisoSaldo = <?php echo Session::get('usuario')->perfil < 3 ? 'true' : 'false'; ?>;
  const idSocio = <?php echo $this->socio->getId(); ?>;

  let paginaActual = 1;
  const porPagina = 10;
  let movimientosData = [];
  let aniosPoblados = false;

  async function cargarMovimientos(pagina = 1) {
    if (!tienePermisoSaldo) return;
    paginaActual = pagina;
    el('#tabla-movimientos').innerHTML = '<tr><td colspan="4" class="px-4 py-4 text-center text-gray-500">Cargando... (id:' + idSocio + ')</td></tr>';
    try {
      const res = await fetch('/movimientos/getMovimientosSocio', {
        method: 'POST',
        body: new URLSearchParams({
          id: idSocio,
          limit: 0
        })
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      movimientosData = await res.json();
      poblarAnios();
      renderizarTabla();
    } catch (e) {
      console.error('Error cargarMovimientos:', e);
      el('#tabla-movimientos').innerHTML = '<tr><td colspan="4" class="px-4 py-4 text-center text-red-500">Error: ' + e.message + '</td></tr>';
    }
  }

  function renderizarTabla() {
    if (!tienePermisoSaldo) return;
    const anio = el('#filtro-anio').value;
    const tipo = el('#filtro-tipo').value;

    let filtrado = movimientosData.filter(m => {
      const mAnio = m.anio ? m.anio.toString() : '';
      const mTipo = parseFloat(m.importe) >= 0 ? 'cuota' : 'pago';
      return (!anio || mAnio === anio) && (!tipo || mTipo === tipo);
    });

    filtrado.sort((a, b) => new Date(b.fecha_iso) - new Date(a.fecha_iso));

    let totalFiltrado = 0;
    filtrado.forEach(m => totalFiltrado += parseFloat(m.importe));

    const inicio = (paginaActual - 1) * porPagina;
    const paginado = filtrado.slice(inicio, inicio + porPagina);

    let html = '';
    if (paginado.length === 0) {
      html = '<tr><td colspan="4" class="px-4 py-4 text-center text-gray-500">No hay movimientos</td></tr>';
    } else {
      paginado.forEach(m => {
        const esPago = parseFloat(m.importe) < 0;
        const clase = esPago ? 'text-green-600' : 'text-red-600';
        const signo = esPago ? '+' : '-';
        const tipoLabel = esPago ? 'Pago' : 'Cuota ' + m.mes + '/' + m.anio;
        html += '<tr class="border-b hover:bg-gray-50">';
        html += '<td class="px-4 py-2 text-sm">' + m.fecha_computo + '</td>';
        html += '<td class="px-4 py-2 text-sm">' + tipoLabel + '</td>';
        html += '<td class="px-4 py-2 text-sm text-right ' + clase + '">' + signo + '$' + Math.abs(parseFloat(m.importe)).toFixed(2) + '</td>';
        html += '<td class="px-4 py-2 text-center"><button onclick="eliminarMovimiento(' + m.id_cuota + ')" class="text-red-500 hover:text-red-700 text-sm">Eliminar</button></td>';
        html += '</tr>';
      });
    }

    el('#tabla-movimientos').innerHTML = html;
    el('#saldo-total').textContent = (totalFiltrado >= 0 ? '$' : '-$') + Math.abs(totalFiltrado).toFixed(2);
    el('#saldo-total').classList.remove('text-green-600', 'text-red-600');
    el('#saldo-total').classList.add(totalFiltrado >= 0 ? 'text-green-600' : 'text-red-600');

    const totalPaginas = Math.ceil(filtrado.length / porPagina);
    el('#info-paginacion').textContent = 'Página ' + paginaActual + ' de ' + totalPaginas + ' (' + filtrado.length + ' registros)';
    el('#btn-anterior').disabled = paginaActual === 1;
    el('#btn-siguiente').disabled = paginaActual >= totalPaginas;
  }

  function poblarAnios() {
    if (!tienePermisoSaldo) return;
    if (aniosPoblados) return;
    aniosPoblados = true;
    const anios = {};
    movimientosData.forEach(m => {
      if (m.anio) anios[m.anio] = true;
    });
    let opciones = '<option value="">Todos los años</option>';
    Object.keys(anios).sort((a, b) => b - a).forEach(a => {
      opciones += '<option value="' + a + '">' + a + '</option>';
    });
    el('#filtro-anio').innerHTML = opciones;
  }

  function paginaAnterior() {
    if (paginaActual > 1) cargarMovimientos(paginaActual - 1);
  }

  function paginaSiguiente() {
    cargarMovimientos(paginaActual + 1);
  }

  function abrirModalPago() {
    el('#pago-fecha').value = new Date().toISOString().split('T')[0];
    el('#modal-pago').classList.remove('hidden');
    el('#modal-pago').classList.add('flex');
  }

  function cerrarModalPago() {
    el('#modal-pago').classList.remove('flex');
    el('#modal-pago').classList.add('hidden');
  }

async function guardarPago() {
    const importe = parseFloat(el('#pago-importe').value);
    const fecha = el('#pago-fecha').value;
    if (!importe || !fecha) {
      alert('Complete todos los campos');
      return;
    }
    try {
      await fetch('/movimientos/ingresarPago', {
        method: 'POST',
        body: new URLSearchParams({ id: idSocio, importe, fecha })
      });
      cerrarModalPago();
      cargarMovimientos();
      el('#pago-importe').value = '';
    } catch (e) {
      console.error(e);
    }
  }

  async function eliminarMovimiento(id) {
    if (!confirm('¿Eliminar este movimiento?')) return;
    try {
      await fetch('/movimientos/eliminar', {
        method: 'POST',
        body: new URLSearchParams({ id })
      });
      cargarMovimientos();
    } catch (e) {
      console.error(e);
    }
  }

  if (tienePermisoSaldo) cargarMovimientos();

  function mostrarImagen(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = (e) => el('#img-previa').src = e.target.result;
      reader.readAsDataURL(input.files[0]);
    }
  }

  el('#foto').addEventListener('change', () => mostrarImagen(el('#foto')));

  const frm = el('#form1');
  frm.addEventListener('submit', async (evt) => {
    evt.preventDefault();
    if (frm.apellido.value == '') {
      alert('Debe ingresar nombre y apellido por separado');
      return;
    }
    const formData = new FormData();
    formData.append('documento', frm.documento.value);
    const res = await fetch('/socios/getByDocumento', {
      method: 'POST',
      body: formData
    });
    const resultado = await res.json();
    if (frm.documento.dataset.doc != frm.documento.value) {
      if (resultado.documento != 0) {
        el('#alerta').innerHTML = 'Socio existente en la base de datos, revise';
        frm.documento.focus();
        return;
      }
      if (digitoCedula(frm.documento.value)) {
        frm.submit();
      } else {
        alert('Cédula erronea, verifique');
        frm.documento.focus();
      }
    } else {
      frm.submit();
    }
  });

  function digitoCedula(ci) {
    const digitoIngresado = ci.substring(ci.length - 1);
    const cedula = ci.substring(0, ci.length - 1);
    let arrayCedula = cedula.split('');
    if (arrayCedula.length < 6) return false;
    if (arrayCedula.length == 6) arrayCedula.unshift(0);
    const testigo = [2, 9, 8, 7, 6, 3, 4];
    let sumatoria = 0;
    for (let i in testigo) sumatoria += testigo[i] * arrayCedula[i];
    let modulo = sumatoria % 10;
    if (modulo == 0) modulo = 10;
    return 10 - modulo == digitoIngresado;
  }

  function soloNumeros(e) {
    const key = e.keyCode || e.which;
    const numeros = "0123456789";
    const teclado = String.fromCharCode(key);
    const especiales = [8, 9, 37, 39, 46];
    const teclado_especial = especiales.includes(key);
    if (numeros.indexOf(teclado) == -1 && !teclado_especial) return false;
  }

  function quitaPuntos() {
    el('#documento').value = el('#documento').value.replace(/\./g, '');
  }
</script>
<div class="max-w-7xl mx-auto px-4" id="resultado"></div>

<!-- Modal Pago -->
<div id="modal-pago" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
  <div class="bg-white rounded-lg p-6 w-full max-w-md mx-4 shadow-xl">
    <h3 class="text-lg font-semibold mb-4 text-gray-800">Registrar Pago</h3>
    <input type="hidden" id="pago-socio-id">
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Fecha</label>
      <input type="date" id="pago-fecha" class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400">
    </div>
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">Importe</label>
      <input type="number" id="pago-importe" step="0.01" min="0.01" class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400">
    </div>
    <div class="flex justify-end gap-2">
      <button type="button" onclick="cerrarModalPago()" class="px-4 py-2 border rounded hover:bg-gray-50">Cancelar</button>
      <button type="button" onclick="guardarPago()" class="px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600">Guardar</button>
    </div>
  </div>
</div>

<script type="text/javascript">
  function abrirModalPago(socioId) {
    document.getElementById('pago-socio-id').value = socioId
    document.getElementById('pago-fecha').value = new Date().toISOString().split('T')[0]
    document.getElementById('pago-importe').value = ''
    document.getElementById('modal-pago').classList.remove('hidden')
    document.getElementById('modal-pago').classList.add('flex')
  }

  function cerrarModalPago() {
    document.getElementById('modal-pago').classList.remove('flex')
    document.getElementById('modal-pago').classList.add('hidden')
  }

  async function guardarPago() {
    const socioId = document.getElementById('pago-socio-id').value
    const fecha = document.getElementById('pago-fecha').value
    const importe = document.getElementById('pago-importe').value
    if (!importe || !fecha) {
      alert('Complete todos los campos')
      return
    }
    try {
      const res = await fetch('/movimientos/ingresarPago/P', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'X-CSRF-TOKEN': csrfToken,
          'Content-Type': 'application/x-www-form-urlencoded'
        },
        body: new URLSearchParams({
          id: socioId,
          importe: importe,
          fecha: fecha
        })
      })
      cerrarModalPago()
      document.getElementById('form1').dispatchEvent(new Event('submit'))
    } catch (e) {
      console.error(e)
      alert('Error al guardar el pago')
    }
  }

  const frm = document.getElementById('form1')

  frm.addEventListener('submit', async (evt) => {
    evt.preventDefault()
    let formData = new FormData()
    formData.append('search', frm.search.value)
    formData.append('_token', csrfToken)
    let res = await fetch('/socios/getByDoc', {
      method: 'post',
      credentials: 'same-origin',
      headers: {
        'X-CSRF-TOKEN': csrfToken
      },
      body: formData
    })
    let resultado = await res.json()
    console.log(resultado)

    let saldoRes = await fetch('/movimientos/getSaldo', {
      method: 'post',
      credentials: 'same-origin',
      headers: {
        'X-CSRF-TOKEN': csrfToken
      },
      body: new URLSearchParams({
        id: resultado.id,
        limit: 0
      })
    })
    let saldoData = await saldoRes.json()
    let saldo = Array.isArray(saldoData) ? saldoData.reduce((acc, m) => acc + parseFloat(m.importe || 0), 0) : 0
    const saldoClase = saldo >= 0 ? 'text-red-600' : 'text-green-600'
    const saldoSigno = saldo >= 0 ? '-$' : '+$'

    let html = `
    <div class="bg-white rounded-lg shadow-md p-6 mb-4">
      <div class="flex items-center justify-between mb-4">
        <div>
          <p class="text-sm text-gray-500">Saldo Actual</p>
          <p class="text-3xl font-bold ${saldoClase}">${saldoSigno}${Math.abs(saldo).toFixed(2)}</p>
        </div>
        <div class="text-right">
          <p class="text-sm text-gray-500">Socio #${resultado.id}</p>
          <p class="text-lg font-semibold text-gray-800">${resultado.nombre}</p>
          <p class="text-gray-600">${resultado.documento}</p>
        </div>
      </div>
    </div>
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <table class="table w-full">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b hover:bg-gray-50">
            <td class="px-4 py-3">
              <a href="/socios/editar/${resultado.id}" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded mr-2 inline-block">Editar</a>
              <button type="button" onclick="abrirModalPago(${resultado.id})" class="bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded mr-2 inline-block">Registrar Pago</button>
              <a href="/socios/confirmar/${resultado.id}" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded inline-block">Eliminar</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>`
    document.getElementById('resultado').innerHTML = html
  })

  function soloNumeros(e) {
    key = e.keyCode || e.which
    let numeros = "0123456789"
    let teclado = String.fromCharCode(key)
    let especiales = [8, 9, 37, 39, 46]
    if (teclado == '.') {
      return false
    }
    let teclado_especial = false
    for (let i in especiales) {
      if (key == especiales[i]) {
        teclado_especial = true
      }
    }
    if (numeros.indexOf(teclado) == -1 && !teclado_especial) {
      return false
    }
  }
</script>
<p>&nbsp;</p>
<div id="divpago" class="container">
    <h3 class="etiquetas">Cambio de valores para imprimir</h3>
    <form id="form_medidas" class="form-horizontal">
        <div class="row">
            <div class="col-md-4"><span class="message" id="message"></span></div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-2">Margen</label>
            <div class="col-md-4">
                <input type="number" name='margen' id='margen' value="<?php echo $this->margen ?>" class="form-control">
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-2">Espacios entre recibos</label>
            <div class="col-md-4">
                <input type="number" name='espacio' id='espacio' value="<?php echo $this->espacio ?>" class="form-control">
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-2">Ajuste Izquierda</label> <!-- Nuevo campo -->
            <div class="col-md-4">
                <input type="number" name='left' id='left' value="<?php echo $this->left ?>" class="form-control">
            </div>
        </div>
        <input type="submit" value="Guardar" class="btn btn-primary" />
    </form>
</div>
<script>
    // Enviar formulario con fetch sin jQuery
    const form = document.querySelector('#form_medidas');
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        const data = new FormData(form);
        const res = await fetch('/ajustes/setajustes', {
            method: 'POST',
            body: data
        });
        const json = await res.json();
        /* const text = await res.text();
        console.log(text); */
        const span = document.querySelector('#message');
        span.innerHTML = json.mensaje;
        span.style.color = json.color;
    });
</script>
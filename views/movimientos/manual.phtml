<script>
const BASE_URL = '<?php echo rtrim(BASE_URL, '/'); ?>';
const frm = document.querySelector('#form_pago');
const idInput = document.querySelector('#id');
const nombreLabel = document.querySelector('#nombre');
const importeInput = document.querySelector('#importe');
const fechaInput = document.querySelector('#fecha');
const ultimosDiv = document.querySelector('#ultimos');

idInput.addEventListener('change', async () => {
    if (!idInput.value) return;
    try {
        const resp = await fetch(BASE_URL + '/socios/loadSocioAjax', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-CSRF-TOKEN': csrfToken
            },
            body: new URLSearchParams({ id: idInput.value })
        });
        const data = await resp.json();
        nombreLabel.textContent = data.nombre || 'No encontrado';
    } catch (err) {
        nombreLabel.textContent = 'Error';
    }
});

idInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
        e.preventDefault();
        importeInput.focus();
    }
});

frm.addEventListener('submit', async (evt) => {
    evt.preventDefault();
    if (fechaInput.value < '1970-01-01') {
        alert("El año tiene que ser de 4 dígitos, por favor revise");
        return;
    }
    try {
        await fetch(BASE_URL + '/movimientos/ingresarPago/M', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-CSRF-TOKEN': csrfToken
            },
            body: new URLSearchParams({
                id: idInput.value,
                importe: importeInput.value,
                fecha: fechaInput.value
            })
        });
        ultimosDiv.innerHTML = '<div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex items-center"><svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>Pago guardado</div>';
        idInput.value = '';
        importeInput.value = '';
        nombreLabel.textContent = '-';
        idInput.focus();
    } catch (err) {
        ultimosDiv.innerHTML = '<div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center"><svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>Error al guardar</div>';
    }
});
</script>
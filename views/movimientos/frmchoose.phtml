<script>
const BASE_URL = "<?php echo rtrim(BASE_URL, '/'); ?>";
const socioInput = document.getElementById('socio');
const btnBuscar = document.getElementById('btn-buscar');

socioInput.addEventListener('keypress', (e) => {
  if (e.key === 'Enter') {
    e.preventDefault();
    buscarSocio();
  }
});

async function buscarSocio() {
  const id = socioInput.value.trim();
  if (id === '') return;

  btnBuscar.disabled = true;
  btnBuscar.textContent = 'Buscando...';

  try {
    const formDataSocio = new FormData();
    formDataSocio.append('id', id);
    let res = await fetch(BASE_URL + '/socios/loadSocioAjax', {
      method: 'post',
      credentials: 'same-origin',
      headers: { 'X-CSRF-TOKEN': csrfToken },
      body: formDataSocio
    });
    let response = await res.json();

    if (response.nombre) {
      document.getElementById('socio-info').classList.remove('hidden');
      document.getElementById('socio-nombre').textContent = response.nombre;
      document.getElementById('socio-doc').textContent = response.documento ? 'CI: ' + response.documento : '';
      document.getElementById('socio-foto').src = BASE_URL + '/views/socios/img/' + (response.foto || 'socio.png');
      document.getElementById('socio-link').href = BASE_URL + '/socios/editar/' + response.id;
      document.getElementById('socio-estado').textContent = response.estado === 'A' ? 'Activo' : 'Inactivo';
      document.getElementById('socio-estado').className = response.estado === 'A' 
        ? 'px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800'
        : 'px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800';
    }

    const formDataSaldo = new FormData();
    formDataSaldo.append('id', id);
    formDataSaldo.append('limit', 6);
    let req = await fetch(BASE_URL + '/movimientos/getSaldo', {
      method: 'post',
      credentials: 'same-origin',
      headers: { 'X-CSRF-TOKEN': csrfToken },
      body: formDataSaldo
    });
    let respuesta = await req.json();

    if (respuesta.length > 0) {
      document.getElementById('saldo-container').classList.remove('hidden');
      const tbody = document.getElementById('saldo-body');
      tbody.innerHTML = respuesta.map(r => `
        <tr>
          <td class="px-4 py-3 text-gray-900">${r.mes}</td>
          <td class="px-4 py-3 text-gray-900">${r.anio}</td>
          <td class="px-4 py-3 text-gray-900 font-semibold">$${Number(r.importe).toLocaleString('es-ES')}</td>
          <td class="px-4 py-3">
            <button type="button" onclick="agregarFila(this, '${id}', '${response.nombre}', '${r.mes}', '${r.anio}', '${r.importe}')"
                    class="px-3 py-1 bg-fogon-900 text-white text-sm rounded hover:bg-fogon-800 transition">
              Agregar
            </button>
          </td>
        </tr>
      `).join('');
    } else {
      document.getElementById('saldo-container').classList.add('hidden');
    }
  } catch (error) {
    console.error('Error:', error);
    alert('Error al buscar el socio');
  } finally {
    btnBuscar.disabled = false;
    btnBuscar.textContent = 'Buscar';
  }
}

function agregarFila(btn, id, nombre, mes, anio, importe) {
  const tbody = document.getElementById('items-body');
  document.getElementById('items-container').classList.remove('hidden');

  const fila = document.createElement('tr');
  fila.className = 'filas';
  fila.innerHTML = `
    <td class="px-4 py-3 text-gray-900">${id}</td>
    <td class="px-4 py-3 text-gray-900">${nombre}</td>
    <td class="px-4 py-3 text-gray-900">${mes}</td>
    <td class="px-4 py-3 text-gray-900">${anio}</td>
    <td class="px-4 py-3 text-gray-900 font-semibold">$${Number(importe).toLocaleString('es-ES')}</td>
    <td class="px-4 py-3">
      <button type="button" onclick="quitarFila(this)" class="text-red-500 hover:text-red-700">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </td>
  `;
  tbody.appendChild(fila);
  
  const row = btn.closest('tr');
  row.remove();
}

function quitarFila(btn) {
  const fila = btn.closest('tr');
  fila.remove();
}

function imprimirSeleccion() {
  const lista = document.querySelectorAll('.filas');
  if (lista.length === 0) {
    alert('Agregue al menos un recibo para imprimir');
    return;
  }

  const listPrint = [...lista].map(l => ({
    id: l.children[0].innerHTML,
    mes: l.children[2].innerHTML,
    anio: l.children[3].innerHTML,
    importe: l.children[4].innerHTML.replace(/\$/g, '').replace(/\./g, '')
  }));

  document.getElementById('datos-json').value = JSON.stringify(listPrint);
  document.getElementById('frmchoose').submit();
}
</script>
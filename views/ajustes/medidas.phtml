<script>
const form = document.querySelector('#form_medidas');
const message = document.querySelector('#message');

form.addEventListener('submit', async function(e) {
    e.preventDefault();
    const data = new FormData(form);
    try {
        const res = await fetch('<?php echo BASE_URL; ?>ajustes/setajustes', {
            method: 'POST',
            credentials: 'same-origin',
            body: data
        });
        const json = await res.json();
        message.innerHTML = `<div class="flex items-center px-4 py-3 rounded-lg ${json.color === 'green' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-red-50 text-red-700 border border-red-200'}">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                ${json.color === 'green' 
                    ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>'
                    : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>'}
            </svg>
            ${json.mensaje}
        </div>`;
        message.classList.remove('hidden');
        setTimeout(() => message.classList.add('hidden'), 4000);
    } catch (err) {
        message.innerHTML = '<div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">Error de conexión</div>';
        message.classList.remove('hidden');
    }
});
</script>
<p>&nbsp;</p>
<div id="divpago" class="max-w-7xl mx-auto px-4">
    <form id="form_pago" class="space-y-4">
        <?php echo csrf_field(); ?>
        <div class="mb-4">
            <label class="font-semibold">Fecha</label>
            <div class="w-full md:w-1/6">

                <input type="date" name='fecha' id='fecha' class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400">
                 
            </div>
            <div class="w-full md:w-1/6"><a id="enlace" href="<?php echo BASE_URL. 'movimientos/getLasts/'?>" class="bg-blue-400 hover:bg-blue-500 text-white font-bold py-2 px-4 rounded" style="pointer-events: none;">Pagos de la fecha</a></div>
        </div>
       
        <div class="mb-4">

            <label class="font-semibold">Nro de Socio</label>
            <div class="w-16">
                <input type="text" name='id' id='id' class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>
            <label id="nombre" name="nombre" md:w-1/3">Name</label>


        </div>
        <div class="mb-4">
            <label class="font-semibold">Importe</label>
            <div class="w-full md:w-1/6">

                <input type="text" name='importe' id='importe' class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>
        </div>

        <input type="button" value="Guardar" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded"/>
    </form>
    <div id="ultimos" style ="width: 100%; display: inline;" ></div>
</div>
<script>
    
    $enlace = document.querySelector("#enlace")
    $date = document.querySelector("#fecha")
    
    $date.addEventListener('change', evt => {
       if(evt.target.value) {
           $enlace.style.pointerEvents = 'auto'
       }
    })
    
    $enlace.addEventListener('click', evt => {
        evt.preventDefault();
        const frm = document.querySelector("#form_pago");
        let url = $enlace.href;
        url+= frm.fecha.value;
        window.location.href = url
        
    })
    

    $('#id').change(function() {
        $.post('/socios/loadSocioAjax', `id=${$(this).val()}`, function(resp) {
            $('#nombre').html(resp.nombre)
        }, 'json')
    })
    $('#form_pago').delegate('#id','keypress', function(e) {
        if(e.keyCode == 13) {
            $('#importe').focus();
        }
    })

    $('#form_pago').delegate('#importe','keypress', function(e) {
        if(e.keyCode == 13) {
            obj = $('#id');
            if($date.value < '1970-01-01') {
                alert("El año debe ser de 4 dígitos, por favor revise")
                return;
            }
                const data = 'id='+obj.val()+'&importe='+$('#importe').val()+'&fecha='+$('#fecha').val();
                $.post('/movimientos/ingresarPago/P', data, function(resp) {

                var contenido = '<p>&nbsp;</p><table class="table table-bordered table-condensed table-striped w-full">'
                contenido += '<tr><th>Id</th><th>Nombre</th><th>Importe</th></tr>'
                for(var i = 0; i < resp.length; i++) {
                    contenido+= '<tr>'

                    contenido += '<td>'+ resp[i].id+'</td><td>'+resp[i].nombre+'</td><td>'+resp[i].importe+'</td></tr>'
                }
                contenido += '</table>'
                $("#ultimos").html('<p></p>');
                $("#ultimos").append(contenido);
            }, 'json')
            
            obj.val('');
            obj.focus();
        }
    })


</script>

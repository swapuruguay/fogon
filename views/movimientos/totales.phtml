<script type="text/javascript">
  document.querySelector('#form-totales').addEventListener('submit', async (evt) => {
    evt.preventDefault();
    const fecha = document.querySelector('#fecha').value;
    const tbody = document.querySelector('#tabla-body');
    tbody.innerHTML = '<tr><td colspan="3" class="px-6 py-8 text-center text-gray-500">Cargando...</td></tr>';
    
    try {
      const resp = await fetch('<?php echo BASE_URL; ?>movimientos/getTotales', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'X-CSRF-TOKEN': csrfToken },
        body: new URLSearchParams({ fecha })
      });
      const data = await resp.json();

      if (data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="3" class="px-6 py-8 text-center text-gray-500">Sin datos para esta fecha</td></tr>';
        return;
      }

      let texto = '';
      let tot = 0;

      data.forEach(r => {
        tot += parseInt(r.importe);
        texto += `<tr class="hover:bg-gray-50">
          <td class="px-6 py-4 text-sm text-gray-800">${r.cat}</td>
          <td class="px-6 py-4 text-sm text-gray-600 text-right">${r.cantidad}</td>
          <td class="px-6 py-4 text-sm text-gray-800 text-right font-medium">$ ${parseInt(r.importe).toLocaleString('es-ES')}</td>
        </tr>`;
      });

      texto += `<tr class="bg-gray-50">
        <td colspan="2" class="px-6 py-4 text-sm font-bold text-gray-900 text-center">Total ===></td>
        <td class="px-6 py-4 text-sm font-bold text-gray-900 text-right">$ ${tot.toLocaleString('es-ES')}</td>
      </tr>`;

      tbody.innerHTML = texto;
    } catch (err) {
      console.error(err);
      tbody.innerHTML = '<tr><td colspan="3" class="px-6 py-8 text-center text-red-500">Error al cargar datos</td></tr>';
    }
  });
</script>
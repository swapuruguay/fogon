<script>
function mostrarModalActivar(id, nombre) {
  document.getElementById('activar-id').value = id;
  document.getElementById('activar-nombre').textContent = nombre;
  document.getElementById('modal-activar').classList.remove('hidden');
}

function cerrarModalActivar() {
  document.getElementById('modal-activar').classList.add('hidden');
}

function confirmarActivar() {
  const id = document.getElementById('activar-id').value;
  window.location.href = '<?php echo BASE_URL; ?>socios/activar/' + id;
}
</script>

<!-- Modal Activar -->
<div id="modal-activar" class="hidden fixed inset-0 z-50 overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4">
    <div class="fixed inset-0 bg-black opacity-50 transition-opacity" onclick="cerrarModalActivar()"></div>
    <div class="relative bg-white rounded-xl shadow-xl max-w-md w-full p-6 transform transition-all">
      <div class="text-center">
        <div class="mx-auto flex items-center justify-center h-14 w-14 rounded-full bg-green-100 mb-4">
          <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">¿Activar este socio?</h3>
        <p class="text-gray-500 mb-6">
          El socio "<strong id="activar-nombre"></strong>" volverá a estar activo en el sistema.
        </p>
        <input type="hidden" id="activar-id">
        <div class="flex items-center justify-center space-x-4">
          <button onclick="cerrarModalActivar()" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">
            Cancelar
          </button>
          <button onclick="confirmarActivar()" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition">
            Activar
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
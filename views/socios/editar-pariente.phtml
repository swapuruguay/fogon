<script>
  const remove = async (evt) => {
    if (!confirm('¿Eliminar este pariente?')) return;

    let $id = document.getElementById('id');
    let $idsoc = document.getElementById('idsoc');
    let formData = new FormData();
    formData.append('id', $id.value);
    let res = await fetch('<?php echo BASE_URL; ?>socios/removePariente', {
      method: 'post',
      body: formData
    });
    let result = await res.json();
    window.location.href = '<?php echo BASE_URL; ?>socios/editar/' + $idsoc.value;
  };

  const frm = document.getElementById('form1');
  const btnRemove = document.getElementById('btn-remove');

  btnRemove.addEventListener('click', remove);

  frm.addEventListener('submit', async (evt) => {
    evt.preventDefault();
    if (frm.apellido.value == '') {
      alert('Debe ingresar nombre y apellido por separado');
      return;
    }

    let formData = new FormData();
    formData.append('documento', frm.documento.value);
    let res = await fetch('<?php echo BASE_URL; ?>socios/getByDocumento', {
      method: 'post',
      body: formData
    });
    let resultado = await res.json();

    if (frm.documento.dataset.doc != frm.documento.value) {
      if (resultado.documento != 0) {
        document.getElementById('alerta').innerHTML = 'Socio existente en la base de datos, revise';
        frm.documento.focus();
        return;
      }

      if (!digitoCedula(frm.documento.value)) {
        alert('Cédula errónea, verifique');
        frm.documento.focus();
        return;
      }
    }

    formData = new FormData();
    formData.append('id', frm.id.value);
    formData.append('idsoc', frm.idsoc.value);
    formData.append('nombre', frm.nombre.value);
    formData.append('apellido', frm.apellido.value);
    formData.append('documento', frm.documento.value);
    formData.append('parentezco', frm.parentezco.value);
    formData.append('sexo', frm.sexo.value);
    formData.append('fecha_nacimiento', frm.fecha_nacimiento.value);

    let result = await fetch('<?php echo BASE_URL; ?>socios/guardarParientes', {
      method: 'post',
      body: formData
    });
    let resultado2 = await result.json();

    alert(resultado2.mensaje);
    window.location.href = '<?php echo BASE_URL; ?>socios/parientes/' + frm.idsoc.value;
  });

  function digitoCedula(ci) {
    if (document.getElementById('check').checked) return true;
    if (ci.length < 6) return false;

    let digitoIngresado = ci.slice(-1);
    let cedula = ci.slice(0, -1);
    let arrayCedula = cedula.split('');

    if (arrayCedula.length === 6) arrayCedula.unshift('0');

    let testigo = [2, 9, 8, 7, 6, 3, 4];
    let sumatoria = 0;
    for (let i = 0; i < testigo.length; i++) {
      sumatoria += testigo[i] * parseInt(arrayCedula[i] || 0);
    }

    return (10 - (sumatoria % 10)) == digitoIngresado;
  }

  function soloNumeros(e) {
    let key = e.keyCode || e.which;
    let numeros = "0123456789";
    let especiales = [8, 9, 37, 39, 46];
    let teclado = String.fromCharCode(key);

    if (numeros.indexOf(teclado) == -1 && !especiales.includes(key)) {
      return false;
    }
  }
</script>
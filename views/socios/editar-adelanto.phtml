<script>
  const form = document.getElementById('form1');
  const ids = document.getElementById('id');
  const nombre = document.getElementById('nombre');
  const resultado = document.getElementById('resultado');

  setTimeout(async () => {
    let formData = new FormData();
    formData.append('id', ids.value);
    let respuesta = await fetch('<?php echo BASE_URL; ?>socios/loadSocioAjax', {
      method: 'post',
      body: formData
    });
    let res = await respuesta.json();
    nombre.innerHTML = res.nombre || '';
  }, 500);

  form.addEventListener('submit', async evt => {
    evt.preventDefault();
    let formData = new FormData(form);
    let res = await fetch('<?php echo BASE_URL; ?>movimientos/guardarAdelanto/<?php echo $this->adelantoid; ?>', {
      method: 'post',
      body: formData
    });
    let resp = await res.json();
    resultado.innerHTML = '<p class="text-green-600 font-medium">' + resp.texto + '</p>';
    resultado.scrollIntoView({ behavior: 'smooth' });
  });
</script>
<script>
  let searchTimeout = null;

  function handleSearch(value) {
    clearTimeout(searchTimeout);

    if (value.length < 2) {
      document.getElementById('searchResults').classList.add('hidden');
      document.querySelectorAll('.member-row').forEach(row => row.style.display = '');
      return;
    }

    searchTimeout = setTimeout(async () => {
      const resultsDiv = document.getElementById('searchResults');

      try {
        const resp = await fetch('<?php echo BASE_URL; ?>socios/buscar?q=' + encodeURIComponent(value), {
          credentials: 'same-origin'
        });
        const socios = await resp.json();

        if (socios.length === 0) {
          resultsDiv.innerHTML = '<div class="p-2 text-gray-500 text-sm">No se encontraron socios</div>';
          resultsDiv.classList.remove('hidden');
          document.querySelectorAll('.member-row').forEach(row => row.style.display = 'none');
          return;
        }

        let html = '<div class="bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden">';
        socios.forEach(s => {
          const badge = s.domicilio && (s.domicilio.toLowerCase().includes('fog')) ?
            '<span class="px-2 py-0.5 text-xs rounded-full bg-emerald-100 text-emerald-800">En el Club</span>' :
            '<span class="px-2 py-0.5 text-xs rounded-full bg-blue-100 text-blue-800">En Calle</span>';
          const nombreCompleto = (s.nombre + ' ' + s.apellido)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
          const docFormatted = s.documento && s.documento.length >= 6 ?
            (s.documento.slice(0, -1).replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.') + '-' + s.documento.slice(-1)) :
            '';
          html += `<div class="flex items-center justify-between p-3 border-b border-gray-100 hover:bg-gray-50">
                    <div class="flex items-center space-x-3">
                        <img src="<?php echo BASE_URL; ?>views/socios/img/${s.foto || 'socio.png'}" class="w-10 h-10 rounded-full object-cover">
                        <div>
                            <p class="font-medium text-gray-900">${nombreCompleto}</p>
                            <div class="flex items-center space-x-3 mt-0.5">
                                <span class="text-xs text-gray-400 font-mono">#${s.id_socio}</span>
                                ${docFormatted ? `<span class="text-xs text-gray-500 font-mono">Doc: ${docFormatted}</span>` : ''}
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3">
                        ${badge}
                        <a href="<?php echo BASE_URL; ?>socios/editar/${s.id_socio}" class="px-3 py-1 bg-fogon-900 text-white text-sm rounded hover:bg-fogon-800">Editar</a>
                    </div>
                </div>`;
        });
        html += '</div>';
        resultsDiv.innerHTML = html;
        resultsDiv.classList.remove('hidden');

        document.querySelectorAll('.member-row').forEach(row => row.style.display = 'none');

      } catch (err) {
        console.error('Search error:', err);
      }
    }, 300);
  }

  function filterSocios(filter) {
    window.location.href = '<?php echo BASE_URL . 'socios/listar/1?filter='; ?>' + filter;
  }
</script>
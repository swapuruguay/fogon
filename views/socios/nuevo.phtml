<script>
const frm = document.getElementById('form1');

frm.addEventListener('submit', async (evt) => {
  evt.preventDefault();
  
  if(frm.nombre.value.trim() === '' || frm.apellido.value.trim() === '') {
    mostrarMensaje('Debe ingresar nombre y apellido', 'error');
    return;
  }

  let formData = new FormData();
  formData.append('documento', frm.documento.value);
  formData.append('_token', csrfToken);

  let res = await fetch('<?php echo BASE_URL; ?>socios/getByDocumento', {
    method: 'post',
    credentials: 'same-origin',
    headers: { 'X-CSRF-TOKEN': csrfToken },
    body: formData
  });
  
  let resultado = await res.json();
  
  if(resultado.documento != 0) {
    mostrarMensaje('Socio existente en la base de datos, revise', 'error');
    frm.documento.focus();
    return;
  }
  
  if(!digitoCedula(frm.documento.value)) {
    mostrarMensaje('Cédula errónea, verifique', 'error');
    frm.documento.focus();
    return;
  }
  
  frm.submit();
});

function mostrarMensaje(texto, tipo) {
  const div = document.getElementById('mensaje');
  div.classList.remove('hidden');
  div.className = `mb-6 p-4 rounded-lg ${tipo === 'error' ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-green-50 text-green-700 border border-green-200'}`;
  div.textContent = texto;
  div.scrollIntoView({ behavior: 'smooth' });
}

function digitoCedula(ci) {
  if(document.getElementById('check').checked) return true;
  
  let digitoIngresado = ci.substring(ci.length - 1);
  let cedula = ci.substring(0, ci.length - 1);
  let arrayCedula = cedula.split('');
  
  if(arrayCedula.length < 6) return false;
  if(arrayCedula.length === 6) arrayCedula.unshift(0);
  
  let testigo = [2,9,8,7,6,3,4];
  let sumatoria = 0;
  
  for(let i in testigo) {
    sumatoria += testigo[i] * arrayCedula[i];
  }

  if((sumatoria % 10) === 0) return 0 == digitoIngresado;
  return 10 - (sumatoria % 10) == digitoIngresado;
}

function soloNumeros(e) {
  let key = e.keyCode || e.which;
  let numeros = "0123456789";
  let teclado = String.fromCharCode(key);
  let especiales = [8,9,37,39,46];
  
  if(teclado === '.') return false;
  
  let teclado_especial = especiales.includes(key);
  
  return numeros.includes(teclado) || teclado_especial;
}

function mostrarImagen(input) {
  if (input.files && input.files[0]) {
    let reader = new FileReader();
    reader.onload = function (e) {
      document.querySelector('#img-previa').src = e.target.result;
    };
    reader.readAsDataURL(input.files[0]);
  }
}

document.querySelector('#foto').addEventListener('change', function() {
  mostrarImagen(this);
});
</script>
<script>
const enlace = document.querySelector('#enlace');
const fecha = document.querySelector('#fecha');
const idInput = document.querySelector('#id');
const nombreLabel = document.querySelector('#nombre');
const importeInput = document.querySelector('#importe');
const ultimosDiv = document.querySelector('#ultimos');
const statusSpan = document.querySelector('#status');
const btnGuardar = document.querySelector('#btn-guardar');

const BASE_URL = '<?php echo rtrim(BASE_URL, '/'); ?>';

fecha.addEventListener('change', () => {
    // No actualiza el href, solo guarda la fecha para el click
});

enlace.addEventListener('click', (evt) => {
    evt.preventDefault();
    if (fecha.value) {
        window.location.href = BASE_URL + '/movimientos/getLasts/' + fecha.value;
    }
});

idInput.addEventListener('change', async () => {
    if (!idInput.value) return;
    
    try {
        const resp = await fetch(BASE_URL + '/socios/loadSocioAjax', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-CSRF-TOKEN': csrfToken
            },
            body: new URLSearchParams({ id: idInput.value })
        });
        const data = await resp.json();
        nombreLabel.textContent = data.nombre || 'No encontrado';
    } catch (err) {
        nombreLabel.textContent = 'Error';
        console.error(err);
    }
});

idInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
        e.preventDefault();
        importeInput.focus();
    }
});

async function guardarPago() {
    if (!idInput.value || !importeInput.value || !fecha.value) {
        statusSpan.textContent = 'Complete todos los campos';
        statusSpan.className = 'text-sm text-red-500';
        return;
    }

    try {
        const resp = await fetch(BASE_URL + '/movimientos/ingresarPago/P', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-CSRF-TOKEN': csrfToken
            },
            body: new URLSearchParams({
                id: idInput.value,
                importe: importeInput.value,
                fecha: fecha.value
            })
        });
        
        const data = await resp.json();
        
        if (Array.isArray(data)) {
            let contenido = '<div class="overflow-x-auto">';
            contenido += '<table class="w-full text-sm">';
            contenido += '<thead><tr class="bg-gray-50"><th class="px-4 py-2 text-left">Id</th><th class="px-4 py-2 text-left">Nombre</th><th class="px-4 py-2 text-right">Importe</th></tr></thead>';
            contenido += '<tbody>';
            data.forEach(p => {
                contenido += `<tr class="border-b border-gray-100"><td class="px-4 py-2">${p.id}</td><td class="px-4 py-2">${p.nombre}</td><td class="px-4 py-2 text-right">$ ${parseFloat(p.importe).toFixed(2)}</td></tr>`;
            });
            contenido += '</tbody></table></div>';
            ultimosDiv.innerHTML = contenido;
            
            statusSpan.textContent = `${data.length} pago(s) registrado(s)`;
            statusSpan.className = 'text-sm text-green-600';
            
            idInput.value = '';
            importeInput.value = '';
            nombreLabel.textContent = '-';
            idInput.focus();
        } else {
            statusSpan.textContent = 'Error al guardar';
            statusSpan.className = 'text-sm text-red-500';
        }
    } catch (err) {
        statusSpan.textContent = 'Error de conexión';
        statusSpan.className = 'text-sm text-red-500';
        console.error(err);
    }
}

btnGuardar.addEventListener('click', guardarPago);

importeInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
        e.preventDefault();
        guardarPago();
    }
});
</script>
<div class="max-w-7xl mx-auto px-4">
<br>
  <div class="flex flex-wrap gap-4">
    <div class="w-full max-w-md">
      <form id="form1" class="space-y-3">
        <?php echo csrf_field(); ?>
        <div class="flex items-center gap-2">
          <label class="etiquetas font-semibold w-32">Nro de Socio</label>
          <input type="text" name='id' id='id' class="border border-gray-300 rounded px-3 py-2 flex-1 focus:outline-none focus:ring-2 focus:ring-blue-400">
          <label id="nombre" class="font-medium"></label>
        </div>
        <div class="flex items-center gap-2">
          <label class="etiquetas font-semibold w-32">Desde</label>
          <input type="date" name='desde' id='desde' class="border border-gray-300 rounded px-3 py-2 flex-1 focus:outline-none focus:ring-2 focus:ring-blue-400">
        </div>
        <div class="flex items-center gap-2">
          <label class="etiquetas font-semibold w-32">Hasta</label>
          <input type="date" name='hasta' id='hasta' class="border border-gray-300 rounded px-3 py-2 flex-1 focus:outline-none focus:ring-2 focus:ring-blue-400">
        </div>
        <input type="submit" value="Guardar" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded cursor-pointer" />
      </form>
    </div>
    <div id="resultado" class="w-full"></div>
  </div>
</div>
<script>
  let form = document.getElementById('form1')
  let nombre = document.getElementById('nombre')
  let ids = document.getElementById('id')
  const $div = document.querySelector('#resultado')
  ids.addEventListener('change', async (evt) => {
    let formData = new FormData()
    formData.append('id', ids.value)
    let respuesta = await fetch(`/socios/loadSocioAjax`, {
      method: 'post',
      body: formData
    })
    let res = await respuesta.json()
    nombre.innerHTML = res.nombre
  })
  
  
  form.addEventListener('submit', async evt => {
    evt.preventDefault();
    if(form.desde.value < '1970-01-01' || form.hasta.value < '1970-01-01') {
      alert("El año debe tener 4 dígitos, por favor revise");
      return;
    }
    let formData = new FormData(form)
    let res = await fetch('/movimientos/ingresarAdelanto', {
      method: 'post',
      body: formData
    })
    let resp = await res.json()
    $div.innerHTML = resp.texto
    form.id.value = ""
    form.desde.value = ""
    form.hasta.value = ""
    form.id.focus();
  })
</script>

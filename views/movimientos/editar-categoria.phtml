<script>
  const form = document.getElementById('form1');
  const resultado = document.getElementById('resultado');

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    fetch('<?php echo BASE_URL; ?>movimientos/guardarCategoria', {
      method: 'POST',
      credentials: 'same-origin',
      body: formData
    })
    .then(response => response.text())
    .then(data => {
      resultado.innerHTML = '<div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex items-center"><svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>Categoría actualizada con éxito</div>';
      resultado.classList.remove('hidden');
      setTimeout(() => {
        window.location.href = '<?php echo BASE_URL; ?>movimientos/listaCategorias';
      }, 1500);
    })
    .catch(error => {
      resultado.innerHTML = '<div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex items-center"><svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>Error al actualizar la categoría</div>';
      resultado.classList.remove('hidden');
    });
  });
</script>
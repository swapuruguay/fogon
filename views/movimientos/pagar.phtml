<p>&nbsp;</p>
<div id="divpago" class="max-w-7xl mx-auto px-4">
    <form id="form_pago" class="space-y-4">
        <?php echo csrf_field(); ?>
        <div class="mb-4">
            <label class="font-semibold">Fecha</label>
            <div class="w-full md:w-1/6">
                <input type="date" name='fecha' id='fecha' class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>
            <div class="w-full md:w-1/6"><a id="enlace" href="<?php echo BASE_URL. 'movimientos/getLasts/'?>" class="bg-blue-400 hover:bg-blue-500 text-white font-bold py-2 px-4 rounded" style="pointer-events: none;">Pagos de la fecha</a></div>
        </div>

        <div class="mb-4">
            <label class="font-semibold">Nro de Socio</label>
            <div class="w-16">
                <input type="text" name='id' id='id' class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>
            <label id="nombre" name="nombre">Name</label>
        </div>
        <div class="mb-4">
            <label class="font-semibold">Importe</label>
            <div class="w-full md:w-1/6">
                <input type="text" name='importe' id='importe' class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>
        </div>

        <input type="button" id="btn-guardar" value="Guardar" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded"/>
    </form>
    <div id="ultimos"></div>
</div>
<script>
    const enlace = document.querySelector('#enlace');
    const fecha = document.querySelector('#fecha');
    const idInput = document.querySelector('#id');
    const nombreLabel = document.querySelector('#nombre');
    const importeInput = document.querySelector('#importe');
    const ultimosDiv = document.querySelector('#ultimos');

    fecha.addEventListener('change', () => {
        if (fecha.value) {
            enlace.style.pointerEvents = 'auto';
        }
    });

    enlace.addEventListener('click', (evt) => {
        evt.preventDefault();
        window.location.href = enlace.href + fecha.value;
    });

    idInput.addEventListener('change', async () => {
        const resp = await fetch('/socios/loadSocioAjax', {
            method: 'POST',
            body: new URLSearchParams({ id: idInput.value })
        }).then(r => r.json());
        nombreLabel.textContent = resp.nombre;
    });

    idInput.addEventListener('keypress', (e) => {
        if (e.keyCode === 13) {
            importeInput.focus();
        }
    });

    importeInput.addEventListener('keypress', async (e) => {
        if (e.keyCode === 13) {
            if (fecha.value < '1970-01-01') {
                alert("El año debe ser de 4 dígitos, por favor revise");
                return;
            }
            const resp = await fetch('/movimientos/ingresarPago/P', {
                method: 'POST',
                body: new URLSearchParams({
                    id: idInput.value,
                    importe: importeInput.value,
                    fecha: fecha.value
                })
            }).then(r => r.json());

            let contenido = '<table class="table table-bordered table-condensed table-striped w-full">';
            contenido += '<tr><th>Id</th><th>Nombre</th><th>Importe</th></tr>';
            resp.forEach(p => {
                contenido += `<tr><td>${p.id}</td><td>${p.nombre}</td><td>${p.importe}</td></tr>`;
            });
            contenido += '</table>';
            ultimosDiv.innerHTML = contenido;

            idInput.value = '';
            idInput.focus();
        }
    });
</script>
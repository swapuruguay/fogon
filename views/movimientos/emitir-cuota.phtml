<script>
  (function() {
    const form = document.getElementById('form1');
    const idSocio = document.getElementById('id_socio');
    const nombreInput = document.getElementById('nombre');
    const importeInput = document.getElementById('importe');
    const categoriaInput = document.getElementById('categoria');
    const mensaje = document.getElementById('mensaje');
    const csrfToken = '<?php echo csrf_token(); ?>';

    // Set default values for fecha, mes, anio
    const today = new Date();
    document.getElementById('fecha').value = today.toISOString().split('T')[0];
    document.getElementById('mes').value = today.getMonth() + 1;
    document.getElementById('anio').value = today.getFullYear();

  idSocio.addEventListener('change', async () => {
    if (!idSocio.value) return;
    
    let formData = new FormData();
    formData.append('id', idSocio.value);
    formData.append('_token', csrfToken);
    let respuesta = await fetch('<?php echo BASE_URL; ?>socios/loadSocioAjax', {
      method: 'post',
      body: formData
    });
    
    if (!respuesta.ok) {
      console.error('Error en loadSocioAjax:', respuesta.status, respuesta.statusText);
      return;
    }
    
    let res = await respuesta.json();
    
    if (res.nombre && res.nombre !== 'No encontrado') {
      nombreInput.value = res.nombre;
      nombreInput.classList.remove('text-gray-500');
      nombreInput.classList.add('text-gray-900');
      
      // Get categoria and importe - solo si tiene documento
      if (res.documento && res.documento !== 'null') {
        formData = new FormData();
        formData.append('documento', res.documento);
        formData.append('_token', csrfToken);
        respuesta = await fetch('<?php echo BASE_URL; ?>socios/getByDocumento', {
          method: 'post',
          body: formData
        });
        
        console.log('getByDocumento response:', respuesta);
        
        if (!respuesta.ok) {
          console.error('Error en getByDocumento:', respuesta.status, respuesta.statusText);
          return;
        }
        
        let socioData = await respuesta.json();
        console.log('socioData:', socioData);
        
        if (socioData.categoria) {
          categoriaInput.textContent = socioData.categoria;
          importeInput.textContent = '$' + parseInt(socioData.importe).toLocaleString('es-UY');
        }
      } else {
        console.log('Socio sin documento:', res);
      }
    } else {
      nombreInput.value = 'Socio no encontrado';
      nombreInput.classList.remove('text-gray-900');
      nombreInput.classList.add('text-red-500');
      importeInput.textContent = '$0';
      categoriaInput.textContent = '';
    }
  });

  form.addEventListener('submit', async (evt) => {
    evt.preventDefault();
    
    if (!idSocio.value || !nombreInput.value || nombreInput.value === 'Socio no encontrado') {
      alert('Debe ingresar un socio válido');
      return;
    }

    let formData = new FormData();
    formData.append('id_socio', idSocio.value);
    formData.append('fecha', form.fecha.value);
    formData.append('mes', form.mes.value);
    formData.append('anio', form.anio.value);
    formData.append('importe', importeInput.textContent.replace('$', '').replace(/\./g, ''));
    formData.append('_token', csrfToken);

    let res = await fetch('<?php echo BASE_URL; ?>movimientos/emitirCuotaManual', {
      method: 'post',
      body: formData
    });
    let resp = await res.json();

    if (resp.ok) {
      mensaje.innerHTML = '<div class="px-4 py-3 rounded-lg bg-green-50 text-green-700">' + resp.mensaje + '</div>';
      // Reset form
      idSocio.value = '';
      nombreInput.value = '';
      nombreInput.classList.remove('text-gray-900');
      nombreInput.classList.add('text-gray-500');
      categoriaInput.textContent = '';
      importeInput.textContent = '$0';
      document.getElementById('mes').value = today.getMonth() + 1;
      document.getElementById('anio').value = today.getFullYear();
    } else {
      mensaje.innerHTML = '<div class="px-4 py-3 rounded-lg bg-red-50 text-red-700">' + resp.mensaje + '</div>';
    }
  });
  })();
</script>
<p>&nbsp;</p>
<div id="divpago" class="max-w-7xl mx-auto px-4">
    <form id="form_pago" class="space-y-4">
        <?php echo csrf_field(); ?>
        <div class="mb-4">
            <label class="font-semibold">Fecha</label>
            <div class="w-full md:w-1/6">
                <input type="date" name='fecha' id='fecha' class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>
        </div>
        <div class="mb-4">
            <label class="font-semibold">Nro de Socio</label>
            <div class="w-16">
                <input type="text" name='id' id='id' class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>
            <label id="nombre" name="nombre">Name</label>
        </div>
        <div class="mb-4">
            <label class="font-semibold">Importe</label>
            <div class="w-full md:w-1/6">
                <input type="text" name='importe' id='importe' class="border border-gray-300 rounded px-3 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>
        </div>

        <input type="submit" value="Guardar" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded"/>
    </form>
    <div id="ultimos"></div>
</div>
<script>
    const frm = document.querySelector('#form_pago');
    const idInput = document.querySelector('#id');
    const nombreLabel = document.querySelector('#nombre');
    const importeInput = document.querySelector('#importe');
    const fechaInput = document.querySelector('#fecha');
    const ultimosDiv = document.querySelector('#ultimos');

    idInput.addEventListener('change', async () => {
        const resp = await fetch('/socios/loadSocioAjax', {
            method: 'POST',
            body: new URLSearchParams({ id: idInput.value })
        }).then(r => r.json());
        nombreLabel.textContent = resp.nombre;
    });

    idInput.addEventListener('keypress', (e) => {
        if (e.keyCode === 13) {
            importeInput.focus();
        }
    });

    frm.addEventListener('submit', async (evt) => {
        evt.preventDefault();
        if (fechaInput.value < '1970-01-01') {
            alert("El año tiene que ser de 4 dígitos, por favor, revise");
            return;
        }
        await fetch('/movimientos/ingresarPago/M', {
            method: 'POST',
            body: new URLSearchParams({
                id: idInput.value,
                importe: importeInput.value,
                fecha: fechaInput.value
            })
        });
        ultimosDiv.innerHTML = '<p>Pago guardado</p>';
        idInput.value = '';
        importeInput.value = '';
        idInput.focus();
    });
</script>